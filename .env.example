# =============================================================================
# Configuración de cotizacion_bna.py
# =============================================================================
#
# 1. Copiá este archivo como ".env" en la MISMA carpeta que cotizacion_bna.py
# 2. Completá los valores de tu entorno
# 3. NO subas el .env a ningún repositorio (sí este .env.example)
#
# Reglas de formato:
#   - Una variable por línea: NOMBRE=valor
#   - Sin comentarios al final de la línea (el '#' se toma como parte
#     del valor, para no romper contraseñas que lo contengan)
#   - No hacen falta comillas, salvo que el valor tenga espacios al inicio
#   - Las listas van separadas por comas
#   - Si dejás una variable vacía o la borrás, se usa el valor por defecto


# -----------------------------------------------------------------------------
# ORACLE  (obligatorio para escribir; no se usa con --solo-consultar)
# -----------------------------------------------------------------------------

ORACLE_USUARIO=TU_USUARIO
ORACLE_PASSWORD=
ORACLE_ALIAS=TU_ALIAS_TNS

# Ruta del ejecutable de SQL*Plus en el servidor.
SQLPLUS_EXE=C:\oracle\product\client\bin\sqlplus.exe

# Esquemas donde se actualiza MONEDAS_COTIZACIONES, separados por coma.
ESQUEMAS_ORACLE=ESQUEMA1,ESQUEMA2,ESQUEMA3


# -----------------------------------------------------------------------------
# COTIZACIÓN BNA
# -----------------------------------------------------------------------------

# Solapa de www.bna.com.ar a leer: divisas | billetes
TIPO_COTIZACION=divisas

# Qué código de MCZ_MONEDA se carga con qué valor del BNA.
# Formato: CODIGO=compra|venta separados por coma.
#   D = DOLARES          -> venta
#   C = Dolar comprador  -> compra
# Para volver al comportamiento viejo (solo venta), dejá: D=venta
MONEDAS_A_ACTUALIZAR=D=venta,C=compra

# true  = aborta si el BNA no publicó la cotización de hoy (recomendado)
# false = acepta la última publicada (sirve para sábados y feriados)
EXIGIR_FECHA_ACTUAL=true

# Reintentos ante caídas del sitio del BNA.
INTENTOS_HTTP=3

# Normalmente no hace falta tocar estos dos.
URL_BNA=https://www.bna.com.ar/Personas
MONEDA_BUSCADA=dolar u.s.a


# -----------------------------------------------------------------------------
# CORREO DE ERROR
# -----------------------------------------------------------------------------
# Si SMTP_PASS queda vacío, el script no intenta enviar mails
# (solo avisa por consola y en el log).

SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=usuario@tudominio.com
SMTP_PASS=
FROM_EMAIL=usuario@tudominio.com

# Destinatarios separados por coma.
TO_EMAIL=destinatario@tudominio.com

EMAIL_SUBJECT=Error al actualizar cotización del dólar


# -----------------------------------------------------------------------------
# LOG
# -----------------------------------------------------------------------------
# Si lo dejás vacío, se usa una subcarpeta "Logs" al lado del .py.

LOG_DIR=
